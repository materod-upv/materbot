// See https://containers.dev/implementors/json_reference/ for configuration reference
{
  "name": "Materbot",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "runArgs": [
    "--env-file",
    ".devcontainer/devcontainer.env",
    "--expose",
    "30000-40000/udp" // Expose the port range for bot sounds
  ]
}